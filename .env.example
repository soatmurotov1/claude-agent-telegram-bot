# Local development and testing settings.
# Create your own copy with:
#   cp .env.example .env && chmod 600 .env
# On Railway this file is NOT used: set Variables with the same names in the service instead.
# Comments must stay on their own lines (a comment after a value is not always parsed correctly).

# Telegram bot token from @BotFather (/newbot). Keep it secret.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram ID of the company account that connects the bot via Telegram Business
# (get it from @userinfobot). Only this account can control the bot (/pause, /resume, /status).
OWNER_ID=

# Company name used in the prompt and in the /start texts.
COMPANY_NAME=Sanoatgeokontexxizmat

# false = PREVIEW mode: replies are only printed to the log, nothing is sent.
# true = replies are sent to the people who wrote. Accepted: true/false/1/0/yes/no/on/off.
AUTO_SEND=false

# Claude subscription token: the sk-ant-oat... value printed by "claude setup-token".
# Create it once on a computer with a browser; it is valid for 1 year. Treat it like a password.
# Paste it with a text editor on ONE line (do not use echo: the token would stay in shell history).
# Leave empty to use this machine's own "claude" login (local testing only).
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty = search PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Claude model alias or full name. Empty = the CLI default.
CLAUDE_MODEL=

# Reasoning effort: low, medium, high, xhigh or max.
CLAUDE_EFFORT=low

# Maximum time for one reply, in seconds (minimum 1).
CLAUDE_TIMEOUT_SECONDS=120

# How long to wait after a usage-limit error when Claude gives no reset time, in minutes (minimum 1).
LIMIT_COOLDOWN_MINUTES=30

# After an employee writes in a chat from the company account, the bot stays silent there
# for this many minutes. 0 disables this.
OWNER_TAKEOVER_MINUTES=15

# The bot's memory: how many of the latest messages with a person (earlier conversations included)
# are sent to Claude as context.
HISTORY_LIMIT=50

# Messages and previews older than this many days are deleted (they may contain personal data).
HISTORY_TTL_DAYS=30
